<section class="prova" id="prova" aria-label="Prova">
  <!-- SCREEN 1 -->
  <section class="prova-screen prova-screen--1" aria-label="Challenger of conventional wisdom">
    <div class="prova-img prova-img--left" aria-hidden="true">
      <img src="/prova/prova-left.webp" alt="" decoding="async" loading="lazy" />
    </div>

    <div class="prova-img prova-img--right" aria-hidden="true">
      <img src="/prova/prova-right.webp" alt="" decoding="async" loading="lazy" />
    </div>

    <div class="prova-headline" aria-label="Headline">
      <span class="prova-dot" aria-hidden="true"></span>

      <div class="prova-lines">
        <div class="prova-line prova-line--top">INTIMATE</div>
        <div class="prova-line prova-line--mid">THEATRICAL</div>
        <div class="prova-line prova-line--bot">IMMERSIVE</div>
      </div>
    </div>
  </section>

  <!-- SCREEN 2 -->
  <section class="prova-screen prova-screen--2" aria-label="The Gala">
    <img
      class="prova-bigword prova-bigword--wisdom prova-logo"
      src="/brand/the-gala-logo-gold.png"
      alt="The Gala"
      width="900"
      height="575"
      decoding="async"
      loading="lazy"
    />

    <aside class="prova-portrait" aria-label="Portrait">
      <img src="/prova/prova-portrait.webp" alt="" decoding="async" loading="lazy" />
    </aside>

    <div class="prova-paragraph prova-paragraph--bottomLeft">
      <p>
        At KOKO, the stage becomes the heart of the <span class="prova-em">evening</span>.
      </p>

      <p>
        World-class <span class="prova-em">performances</span>, spectacular
        <span class="prova-em">showcases</span>, and the excitement of the
        <span class="prova-em">Clash of the Titans Team Match</span> transform the theatre into
        a living stage.
      </p>
    </div>
  </section>

  <!-- SCREEN 3 -->
  <section class="prova-screen prova-screen--3" aria-label="Beliefs">
    <div class="prova-paragraph prova-paragraph--topLeft">
      <p>
        Every moment is designed to <span class="prova-em">surprise</span>,
        <span class="prova-em">inspire</span>, and
        <span class="prova-em">captivate</span>.
      </p>

      <p>
        The magic of <span class="prova-em">live performance</span> fills the room, just steps away from your table.
      </p>

      <p class="prova-closing">
        An evening where <span class="prova-em">theatre</span>,
        <span class="prova-em">performance</span>, and
        <span class="prova-em">elegance</span> come together to create something truly unforgettable.
      </p>
    </div>

    <div class="prova-cornerMedia" aria-hidden="true">
      <img src="/prova/prova-corner.webp" alt="" decoding="async" loading="lazy" />
    </div>

    <h2 class="prova-bigword prova-bigword--beliefs">The stars from previous events</h2>
  </section>
</section>

