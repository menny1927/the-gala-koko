<section class="peGallery" id="past-events" aria-label="Past events gallery">
  <h1 class="peHeading" aria-live="polite"></h1>
  <!-- cards injected here -->
</section>

<div
  class="peLightbox"
  data-pe-lightbox
  role="dialog"
  aria-modal="true"
  aria-labelledby="pe-lightbox-title"
  aria-hidden="true"
>
  <div class="peLightbox__backdrop" data-pe-close></div>

  <div class="peLightbox__panel" tabindex="-1">
    <button
      class="peLightbox__close"
      type="button"
      aria-label="Close image"
      data-pe-close
    >
      ×
    </button>

    <div class="peLightbox__grid">
      <div class="peLightbox__image">
        <img alt="" data-pe-lightbox-image />
      </div>

      <div class="peLightbox__copy">
        <div class="ui">Past events</div>
        <h3 class="peLightbox__title" id="pe-lightbox-title" data-pe-lightbox-title></h3>
      </div>
    </div>
  </div>
</div>
