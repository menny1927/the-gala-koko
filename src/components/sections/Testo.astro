---
import "./testo.css";
---

<section class="testo" id="testo" aria-label="Testo scroll reveal">
  <div class="testo-inner">
    <!-- Cursor is INSIDE the sticky area, and sits UNDER the text -->
    <div class="testo-cursor" aria-hidden="true"></div>

    <div class="testo-lines" aria-label="Quote">
      <p class="testo-line" data-line>
        <span class="testo-text" data-text>Within the KOKO Theatre,</span>
      </p>
      <p class="testo-line" data-line>
        <span class="testo-text" data-text>The Gala unfolds as an</span>
      </p>
      <p class="testo-line" data-line>
        <span class="testo-text" data-text>intimate cabaret of elegance</span>
      </p>
      <p class="testo-line" data-line>
        <span class="testo-text" data-text>performance and connection.</span>
      </p>

      <div class="testo-author">The Gala Team</div>
    </div>

    <div class="testo-quoteMark" aria-hidden="true">“</div>
  </div>
</section>

