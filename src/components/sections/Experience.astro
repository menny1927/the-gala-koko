<section class="experienceStack scene" id="experience">
  <div class="experienceStack__intro container">
    <div class="ui">The experience</div>
    <h2 class="h2">Four ways into the world of the Gala.</h2>
    <p class="p">
      Explore the theatre, discover the setting, revisit the editions that shaped the atmosphere of the evening,
      and meet the people behind it. Each card opens a different part of the experience.
    </p>
  </div>

  <div class="experienceStack__stage">
    <article class="experienceCard" data-experience-card>
      <div class="experienceCard__copy">
        <div>
          <div class="ui">01 / Venue</div>
          <h3 class="experienceCard__title">Inside the theatre</h3>
          <p class="p">
            Step inside KOKO and discover the scale, atmosphere, and visual language that define the evening.
          </p>
        </div>

        <a class="btn" href="/venue">
          View venue
        </a>
      </div>

      <div class="experienceCard__media">
        <img src="/spotlight/img8.webp" alt="KOKO theatre interior" loading="lazy" decoding="async" />
      </div>
    </article>

    <article class="experienceCard" data-experience-card>
      <div class="experienceCard__copy">
        <div>
          <div class="ui">02 / Location</div>
          <h3 class="experienceCard__title">In the Heart of London</h3>
          <p class="p">
            Find the theatre in Camden and explore the arrival details, the surroundings, and where the night begins.
          </p>
        </div>

        <a class="btn" href="/location">
          View location
        </a>
      </div>

      <div class="experienceCard__media">
        <img src="/images/london-map.webp" alt="London location map" loading="lazy" decoding="async" />
      </div>
    </article>

    <article class="experienceCard" data-experience-card>
      <div class="experienceCard__copy">
        <div>
          <div class="ui">03 / Past events</div>
          <h3 class="experienceCard__title">Previous editions</h3>
          <p class="p">
            Revisit past editions, signature performances, and the moments that continue to shape the Gala.
          </p>
        </div>

        <a class="btn" href="/#past-events">
          View past events
        </a>
      </div>

      <div class="experienceCard__media">
        <img src="/images/chapter1.jpg" alt="Past Gala moment" loading="lazy" decoding="async" />
      </div>
    </article>

    <article class="experienceCard" data-experience-card>
      <div class="experienceCard__copy">
        <div>
          <div class="ui">04 / Organizers</div>
          <h3 class="experienceCard__title">Meet the organizers</h3>
          <p class="p">
            Discover the people behind the Gala and the vision, curation, and energy that shape each edition of the evening.
          </p>
        </div>

        <a class="btn" href="/organizers">
          View organizers
        </a>
      </div>

      <div class="experienceCard__media">
        <img src="/images/organizer-1.jpg" alt="Gala organizer portrait" loading="lazy" decoding="async" />
      </div>
    </article>
  </div>

  <div class="experienceReveal" aria-hidden="true">
    <div class="experienceReveal__inner">
      <div class="experienceReveal__kicker">Past events</div>

      <div class="experienceReveal__headline">
        <span class="experienceReveal__word experienceReveal__word--accent">RELIVE</span>
        <span class="experienceReveal__word experienceReveal__word--solid">THE</span>
        <span class="experienceReveal__word experienceReveal__word--outline">MOMENTS</span>
      </div>

      <div class="experienceReveal__meta">
        <h2 class="experienceReveal__sub">
          Moments that still shape the Gala
        </h2>

        <p class="experienceReveal__body">
          Revisit the performances, atmosphere, and signature scenes that continue to define the character of the evening.
        </p>
      
        <p class="experienceReveal__body experienceReveal__body--secondary">
          A return to the nights, gestures, and memories that still echo through each new edition.
        </p>
      </div>
    </div>
  </div>
</section>
