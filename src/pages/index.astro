---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

import KnockGate from "../components/sections/KnockGate.astro";
import Hero from "../components/sections/Hero.astro";
import Experience from "../components/sections/Experience.astro";
import RequestInvite from "../components/sections/RequestInvite.astro";
import Prova from "../components/sections/prova.astro";
import "../components/sections/prova.css";
import PastEventsScatter from "../components/sections/PastEventsScatter.astro";
import "../components/sections/past-events-scatter.css";
import Testo from "../components/sections/Testo.astro";
import "../components/sections/testo.css";
import ProAm from "../components/sections/proam.astro";
import Footer from "../components/sections/Footer.astro";
---

<Layout title="The Gala Meets KOKO">
  <main class="grain" id="main-content">
    <KnockGate />
    <Hero />
    <Prova />
    <ProAm />
    <Testo />
    <Experience />
    <PastEventsScatter />
    <RequestInvite />
    <Footer />
  </main>
</Layout>
