---
import Layout from "../layouts/Layout.astro";
import PageNav from "../components/PageNav.astro";
import "../styles/global.css";
import "../components/sections/koko.css";
import "maplibre-gl/dist/maplibre-gl.css";

// With a key we render a live TomTom vector map (real zoom, geo-anchored pins).
// Without one we fall back to the exported still, so the page never breaks.
const tomtomKey = import.meta.env.PUBLIC_TOMTOM_KEY ?? "";
const useLiveMap = Boolean(tomtomKey);
---

<Layout
  title="Location"
  description="Find KOKO Theatre in Camden and plan your arrival for The Gala."
>
  <PageNav />
  <main id="main-content">
    <section class="koko">
      <div class="koko-img" data-koko-live={useLiveMap ? "true" : null}>
        {useLiveMap ? (
          <div class="koko-map" data-koko-map data-tomtom-key={tomtomKey}></div>
        ) : (
          <>
            <img class="koko-img-el" src="/images/london-map.webp" alt="Map of central London" />

            <div class="koko-marker koko-marker-1">
              <span class="koko-marker-icon"></span>
              <p class="koko-marker-label">KOKO Theatre</p>
            </div>

            <div class="koko-marker koko-marker-2">
              <span class="koko-marker-icon"></span>
              <p class="koko-marker-label">Royal Albert Hall</p>
            </div>
          </>
        )}
      </div>

      <div class="koko-mask"></div>

      <div class="koko-grid-overlay">
        <img src="/grid-overlay.svg" alt="" />
      </div>

      <div class="koko-content">
        <div class="koko-content-block">
          <div class="koko-content-copy">
            <h1>KOKO Theatre</h1>
          </div>
        </div>

        <div class="koko-content-block">
          <div class="koko-content-copy">
            <h2>Address</h2>
            <p>1A Camden High St, London NW1 7JE.</p>
          </div>
        </div>

        <div class="koko-content-block">
          <div class="koko-content-copy">
            <h2>Arrival</h2>
            <p>Please arrive early for check-in and a smooth start.</p>
          </div>
        </div>

        <div class="koko-content-block">
          <div class="koko-content-copy">
            <h2>Nearest station</h2>
            <p>Camden Town Underground.</p>
          </div>
        </div>
      </div>

      <div class="koko-scroll-progress-bar"></div>

      <p class="koko-attribution">
        <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.tomtom.com/legal/en_gb/product-attributions/" rel="noopener">© TomTom</a>
      </p>
    </section>
  </main>

</Layout>
