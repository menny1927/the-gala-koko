---
import { site } from "../data/site.js";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = site.defaultTitle,
	description = site.description,
	image = "/images/hero.jpg",
	noindex = false,
} = Astro.props;

const pageTitle = title === site.defaultTitle ? title : `${title} | ${site.name}`;
const configuredSiteUrl = import.meta.env.PUBLIC_SITE_URL;
const canonical = configuredSiteUrl
	? new URL(Astro.url.pathname, configuredSiteUrl).toString()
	: undefined;
const socialImage = configuredSiteUrl
	? new URL(image, configuredSiteUrl).toString()
	: image;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#070707" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{pageTitle}</title>
	</head>

	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>

		<div class="rotateNotice">
			<div class="rotateNotice__inner">
				<span class="rotateNotice__icon" aria-hidden="true">⟳</span>
				<p class="rotateNotice__title">Please rotate your device</p>
				<p class="rotateNotice__text">This experience is designed for portrait.</p>
			</div>
		</div>

		<slot />

		<script src="../scripts/app.js"></script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	.skip-link {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 100000;
		padding: 10px 14px;
		border-radius: 999px;
		background: #fff;
		color: #000;
		transform: translateY(-180%);
		transition: transform 160ms ease;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	/* keyboard-only affordance — hide on touch devices where it pops up after the gate */
	@media (max-width: 767px), (pointer: coarse) {
		.skip-link {
			display: none;
		}
	}

	/* Landscape phones only: the pinned 100svh sections collapse at ~440px tall,
	   so prompt for portrait rather than rendering a broken layout. Tablets and
	   desktops are excluded by the height and pointer conditions. */
	.rotateNotice {
		display: none;
	}

	@media (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
		.rotateNotice {
			position: fixed;
			inset: 0;
			z-index: 2147483647;
			display: grid;
			place-items: center;
			padding: 24px;
			background: #000;
			color: #f5efe4;
			text-align: center;
		}

		.rotateNotice__icon {
			display: block;
			margin-bottom: 14px;
			color: #ffbc54;
			font-size: 34px;
			line-height: 1;
		}

		.rotateNotice__title {
			margin: 0;
			font-size: 17px;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		.rotateNotice__text {
			margin: 8px 0 0;
			color: rgba(245, 239, 228, 0.62);
			font-size: 13px;
		}
	}
</style>
